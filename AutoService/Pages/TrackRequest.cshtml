@page
@model AutoService.Pages.TrackRequestModel

@{
    ViewData["Title"] = "Отслеживание заявки";
}

<div class="container pt-4 pb-5">
    <div class="mx-auto" style="max-width: 760px;">
        <div class="mb-4">
            <span class="text-info fw-bold small">ТЕХНОДРАЙВ</span>
            <h1 class="mt-2">Мои заявки</h1>
            <p class="text-secondary">Введите номер телефона, который указывали при записи. Покажем все ваши заявки.</p>
        </div>

        <div class="p-4 rounded-3 border">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Телефон" class="form-label">Номер телефона</label>
                    <input asp-for="Телефон" type="tel" class="form-control" placeholder="Например, +7 962 123-45-67" required />
                </div>
                <button type="submit" class="btn btn-primary">Найти мои заявки</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.Сообщение))
            {
                <div class="alert @(Model.Сообщение == "Заявка отменена." ? "alert-success" : "alert-warning") mt-3 mb-0">@Model.Сообщение</div>
            }
        </div>

        @if (Model.Заявки.Count > 0)
        {
            <h2 class="h4 mt-4 mb-3">Найдено заявок: @Model.Заявки.Count</h2>
            @foreach (var заявка in Model.Заявки)
            {
                <div class="mt-3 p-4 rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h2 class="h5 mb-0">@заявка.НазваниеУслуги</h2>
                        <span class="badge bg-info text-dark">@заявка.Статус</span>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Дата записи</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(заявка.ДатаЗаявки) ? "Не указана" : заявка.ДатаЗаявки)</dd>
                        <dt class="col-sm-5">Дата обслуживания</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(заявка.ДатаОбслуживания) ? "Не назначена" : заявка.ДатаОбслуживания)</dd>
                        <dt class="col-sm-5">Время обслуживания</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(заявка.ВремяОбслуживания) ? "Не назначено" : заявка.ВремяОбслуживания)</dd>
                        <dt class="col-sm-5">Описание проблемы</dt>
                        <dd class="col-sm-7">@заявка.ОписаниеПроблемы</dd>
                    </dl>
                    @if (заявка.Статус != "Отменена" && заявка.Статус != "Завершена")
                    {
                        <form method="post" asp-page-handler="Cancel" class="mt-3" onsubmit="return confirm('Вы уверены, что хотите отменить эту заявку?');">
                            <input type="hidden" name="Телефон" value="@Model.Телефон" />
                            <input type="hidden" name="идентификатор" value="@заявка.Идентификатор" />
                            <button type="submit" class="btn btn-outline-danger">Отменить заявку</button>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>
